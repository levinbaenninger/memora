{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!.agents/skills",
      "!.claude/skills",
      "!packages/ui/src/components",
      "!packages/ui/src/hooks",
      "!packages/ui/src/lib/utils.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/web/src/routes/api/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@memora/**"],
              ":BLANK_LINE:",
              ["@memora/**"],
              ":BLANK_LINE:"
            ]
          }
        }
      }
    }
  }
}
